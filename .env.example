# Names only. Copy to .env and fill values locally. Never commit .env.
# --- Circle (executor + local scripts ONLY) ---
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
# filled by `pnpm circle:setup` output
CIRCLE_WALLET_SET_ID=
TREASURY_WALLET_ID=
TREASURY_WALLET_ADDRESS=
# --- Network (testnet only) ---
TWOKEY_NETWORK=testnet
CIRCLE_BLOCKCHAIN=ARC-TESTNET
ARC_CHAIN_ID=5042002
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_EXPLORER_URL=https://explorer.testnet.arc.io
USDC_TOKEN_ADDRESS=0x3600000000000000000000000000000000000000
DEFAULT_FEE_ESTIMATE_USDC=0.010000
ORG_TIMEZONE=Asia/Kolkata
# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/twokey_arc
# --- Web ---
SESSION_SECRET=
OWNER_EMAIL=
OWNER_PASSWORD_HASH=
AGENT_KEY_PEPPER=
APP_BASE_URL=http://localhost:3000
DEMO_MODE=true
# --- Agent side ---
TWOKEY_URL=http://localhost:3000
TWOKEY_AGENT_KEY=
