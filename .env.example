# Names only. Copy to .env and fill in locally; Railway gets the same names as service variables.
# Never commit .env. Never paste these values into chat.

# --- Circle (EXECUTOR + local scripts ONLY; the web app refuses to boot if these are set) ---
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
# written by `pnpm circle:setup`
CIRCLE_WALLET_SET_ID=
TREASURY_WALLET_ID=
TREASURY_WALLET_ADDRESS=

# --- Network (testnet only in this build) ---
TWOKEY_NETWORK=testnet
CIRCLE_BLOCKCHAIN=ARC-TESTNET
ARC_CHAIN_ID=5042002
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_EXPLORER_URL=https://explorer.testnet.arc.io
USDC_TOKEN_ADDRESS=0x3600000000000000000000000000000000000000
DEFAULT_FEE_ESTIMATE_USDC=0.010000
ORG_TIMEZONE=Asia/Kolkata
TWOKEY_ORG_ID=org_twokey

# --- Database (docker compose up -d postgres) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/twokey_arc

# --- Web ---
# `pnpm owner:set-password you@example.com` writes OWNER_EMAIL + OWNER_PASSWORD_HASH
OWNER_EMAIL=
OWNER_PASSWORD_HASH=
OWNER_NAME=Prabal
# `pnpm seed` generates AGENT_KEY_PEPPER and TWOKEY_AGENT_KEY
AGENT_KEY_PEPPER=
APP_BASE_URL=http://localhost:3000
DEMO_MODE=true
# Seconds between "approved" and execution (a short undo window; the drift demo needs >= 3)
APPROVAL_GRACE_SECONDS=5

# --- Telegram approvals (web + executor) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVER_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MAX_APPROVE_USDC=100

# --- Agent side (demo agent, MCP, demo-run) ---
TWOKEY_URL=http://localhost:3000
TWOKEY_AGENT_KEY=
# demo-run logs in as the owner to approve; local only
DEMO_OWNER_PASSWORD=
